{
  "$id": "spiele/bildpuzzle/schema.json",
  "title": "Bildpuzzle",
  "description": "Ein Foto in Teilen; die Gruppe tauscht Teile, bis das Bild stimmt.",
  "type": "object",
  "required": ["format", "titel", "text", "dauerMinuten", "belohnung", "stufe", "bild", "raster", "teile"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "bildpuzzle" },
    "titel": { "type": "string", "minLength": 1, "maxLength": 60 },
    "text": { "$ref": "#/$defs/zweitext" },
    "dauerMinuten": { "type": "number", "minimum": 5, "maximum": 10 },
    "belohnung": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/kennung" } },
    "stufe": { "enum": ["einblick", "kennen", "anwenden", "beurteilen", "gestalten"] },
    "rollen": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/kennung" } },
    "mischen": { "type": "integer", "minimum": 0 },
    "quelle": { "type": "string", "minLength": 3 },
    "wusstetIhr": { "$ref": "#/$defs/zweitext" },
    "bild": { "$ref": "#/$defs/bild" },
    "raster": {
      "type": "object",
      "required": ["spalten", "zeilen"],
      "additionalProperties": false,
      "properties": {
        "spalten": { "type": "integer", "minimum": 2, "maximum": 5 },
        "zeilen": { "type": "integer", "minimum": 2, "maximum": 5 }
      }
    },
    "teile": {
      "description": "Was jedes Teil zeigt, Reihe für Reihe von links oben; für Bildschirmleser. Anzahl = spalten × zeilen.",
      "type": "array", "minItems": 4, "maxItems": 25,
      "items": { "$ref": "#/$defs/zweitext" }
    },
    "tipps": {
      "description": "Texte der drei Tippstufen (1 ganzes Foto, 2 richtige Teile markieren, 3 ein Teil legen); ohne Angabe gelten Standardtexte.",
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/tipp" }
    }
  },
  "$defs": {
    "zweitext": {
      "type": "object",
      "required": ["standard", "einfach"],
      "additionalProperties": false,
      "properties": {
        "standard": { "type": "string", "minLength": 1, "maxLength": 600 },
        "einfach": { "type": "string", "minLength": 1, "maxLength": 600 }
      }
    },
    "kennung": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
    "bild": {
      "type": "object",
      "required": ["datei", "breite", "hoehe", "alt", "quelle"],
      "additionalProperties": false,
      "properties": {
        "datei": { "type": "string", "pattern": "^assets/spiele/[a-z0-9/_.-]+\\.(webp|jpg|png|svg)$" },
        "breite": { "type": "integer", "minimum": 200 },
        "hoehe": { "type": "integer", "minimum": 200 },
        "alt": { "$ref": "#/$defs/zweitext" },
        "quelle": { "type": "string", "minLength": 3, "maxLength": 300 }
      }
    },
    "tipp": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/zweitext" },
        "nochmal": { "$ref": "#/$defs/zweitext" }
      }
    }
  }
}
