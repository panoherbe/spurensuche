# Vorlage für .env (kopieren nach .env und anpassen; .env nie ins Repository). Beschreibung: docs/KONFIGURATION.md

# Adresse, unter der die Anwendung für Nutzende erreichbar ist (hinter dem Reverse Proxy, mit https)
SPUR_OEFFENTLICHE_URL=https://spurensuche.example.org
# Port auf 127.0.0.1 des Hosts, an den der Reverse Proxy weiterleitet
SPUR_HOST_PORT=8080

# Schlüssel der Verwaltung (mindestens 16 Zeichen). Ohne Wert erzeugt der erste Start einen und schreibt ihn einmal ins Protokoll.
SPUR_VERWALTUNG_SCHLUESSEL=
# Schlüssel, mit dem das Ausstellungssystem freigegebene Bildbeiträge abruft (Bearer-Token)
SPUR_AUSSTELLUNG_TOKEN=
# Schlüssel für die Messwerte des Monitorings (/api/v1/betrieb/messwerte)
SPUR_MESSWERTE_TOKEN=

# Anmeldedienst (OpenID Connect). Leer lassen, solange nur Zugangsschlüssel genutzt werden.
SPUR_OIDC_AUSSTELLER=
SPUR_OIDC_CLIENT_ID=spurensuche
SPUR_OIDC_CLIENT_SECRET=
SPUR_OIDC_ROLLEN_MERKMAL=rolle
SPUR_OIDC_ROLLEN_LEHRKRAFT=lehrkraft
SPUR_OIDC_ROLLEN_LERNENDE=schueler,lernende
# optional | pflicht: Müssen sich Lernende vor dem Beitritt mit dem Schulkonto anmelden?
SPUR_LERNENDE_ANMELDUNG=optional

# Aufbewahrung der Gruppendaten in Wochen nach Ende der Quest (höchstens bis zum Ende des Schuljahres)
SPUR_AUFBEWAHRUNG_WOCHEN=12

# Sicherung: Schlüssel (32 Byte, Base64; erzeugen mit „openssl rand -base64 32“). Getrennt von der Sicherung aufbewahren!
SPUR_SICHERUNG_SCHLUESSEL=
SPUR_SICHERUNG_ANZAHL=14
TZ=Europe/Berlin

# Nur für Tests und Vorführung: Attrappe des Anmeldedienstes mit Testkonten. In Produktion nie einschalten.
SPUR_ATTRAPPE=0
